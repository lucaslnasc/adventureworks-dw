# Credenciais padrão deliberadas para este laboratório local.
# O .env já está preparado; copie este modelo somente se ele não existir.
# Se a senha contiver $, coloque o valor entre aspas simples no .env.
# Exemplos de laboratório; mantenha as credenciais efetivas no .env, fora do Git.
MSSQL_SA_PASSWORD=SqlServer2026!
PGPASSWORD=Postgres2026!
AIRFLOW_DB_PASSWORD=AirflowDB2026!

# Nome do banco restaurado e usuário de conexão na origem.
SOURCE_DB=AdventureWorks2016
SOURCE_USER=sa
# Banco e usuário utilizados pelo ETL no destino PostgreSQL.
PGDATABASE=adventureworks_dw
PGUSER=dw

# Portas diferentes da versão anterior. Uso local, somente em 127.0.0.1.
# Portas do computador: conexões entre serviços usam as portas internas do Compose.
MSSQL_PORT=14331
PGPORT_EXTERNAL=54331
AIRFLOW_PORT=8081
# Acesso à interface do Airflow; separado da senha de seu banco de metadados.
AIRFLOW_USER=aluno
AIRFLOW_PASSWORD=Airflow2026!

# Pasta do backup existente, relativa a este compose.yaml.
BACKUP_DIR=./backups
